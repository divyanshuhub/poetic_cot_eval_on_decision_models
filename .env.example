# Gemini generation
GEMINI_API_KEY=

# Select the first visible GPU by default. Change this to the A100's index if
# your machine exposes it under a different index.
CUDA_VISIBLE_DEVICES=0

# Laya runs directly through the local `laya` Python package.
# Leave LAYA_CHECKPOINT empty to use its automatic English routing.
LAYA_DEVICE=cuda
# LAYA_CHECKPOINT=typed-decisions
LAYA_PRELOAD=0

# Kev and Clef run against servers you start on this machine. The defaults are
# their documented local SystemOne endpoints, with no hosted service involved.
# For fine-tuned Kev evaluation, set KEV_MODEL_ID in .env to the trained
# checkpoint directory; the value below selects the released base adapter.
KEV_MODEL_ID=jaredpalmer/kev-4b
KEV_API_URL=http://127.0.0.1:8008/v1/systemone
KEV_DTYPE=bf16
# The launcher auto-detects a nested checkout; override only if needed.
# KEV_REPO_DIR=/path/to/kev/project-root
# KEV_API_KEY=                 # Only when you protect your own local server.

CLEF_MODEL_ID=Cloudflare/clef-flash
CLEF_API_URL=http://127.0.0.1:30000/v1/systemone
# CLEF_API_KEY=                # Only when you protect your own local server.

# Use Cloudflare/clef for the larger 27B model.
# CLEF_MODEL_ID=Cloudflare/clef

# Optional loopback endpoint overrides are available through KEV_API_URL and
# CLEF_API_URL above. Laya runs directly in-process and has no API key.
